    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "canvas-confetti": "^1.9.4",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "flag-icons": "^7.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "suncalc": "^2.1.1",
