{
  "name": "vitale-geo",
  "version": "1.0.0",
  "description": "Portal VitaleGeo - Inteligência Geográfica",
  "type": "module",
  "main": "gerar_sitemap.js",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/sync-youtube-videos.js && node gerar_sitemap.js && node scripts/gerar-rss.js && astro build",
    "sync:videos": "node scripts/sync-youtube-videos.js",
    "sync:videos:full": "node scripts/sync-youtube-videos.js --full",
    "cerebro": "node scripts/sync-cerebro-geo.js",
    "preview": "astro preview",
    "sitemap": "node gerar_sitemap.js",
    "rss": "node scripts/gerar-rss.js",
    "indexnow": "node scripts/ping-indexnow.js",
    "seo": "node scripts/sync-youtube-videos.js && node gerar_sitemap.js && node scripts/gerar-rss.js && node scripts/ativar-discover-e-rss.js && node scripts/ping-indexnow.js",
    "ship": "node scripts/ship.js",
    "deploy": "node scripts/ship.js"
