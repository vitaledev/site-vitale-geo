---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: string;
}

const {
  title = 'VitaleGeo | Geopolítica, Fronteiras & Cartografia',
  description = 'Investigações territoriais, anomalias de fronteiras, rotas navais estratégicas e simuladores de escala real.',
  image = '/assets/img/publisher/logo-publisher-square-1000.png',
  canonical = Astro.url.href,
  type = 'website'
} = Astro.props;

const siteUrl = 'https://www.vitalegeo.com.br';
const fullImageUrl = image.startsWith('http') 
  ? image 
  : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
---

<!DOCTYPE html>
<html lang="pt-br" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonical} />

  <!-- Metatags Essenciais de Indexação & Google Discover -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <link rel="alternate" type="application/rss+xml" title="VitaleGeo | Feed RSS" href="https://www.vitalegeo.com.br/rss.xml" />

  <!-- Verificação de Motores de Busca -->
  <meta name="msvalidate.01" content="E7F00CCD24D2356D8B5DCB967D43C223" />
  <meta name="google-site-verification" content="8fb15f4febc23b92" />

  <!-- Open Graph / Redes Sociais (WhatsApp, Telegram, Facebook, LinkedIn) -->
  <meta property="og:type" content={type} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content="VitaleGeo" />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullImageUrl} />
  <meta property="og:image:alt" content={title} />

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullImageUrl} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Schema.org JSON-LD para WebSite & Organização Oficial -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://www.vitalegeo.com.br/#website",
        "url": "https://www.vitalegeo.com.br/",
        "name": "VitaleGeo",
        "description": "Investigações territoriais, anomalias de fronteiras, rotas navais estratégicas e simuladores de escala real.",
        "publisher": {
          "@id": "https://www.vitalegeo.com.br/#organization"
        },
        "inLanguage": "pt-BR"
      },
      {
        "@type": "Organization",
        "@id": "https://www.vitalegeo.com.br/#organization",
        "name": "VitaleGeo",
        "url": "https://www.vitalegeo.com.br/",
        "logo": {
          "@type": "ImageObject",
          "@id": "https://www.vitalegeo.com.br/#logo",
          "url": "https://www.vitalegeo.com.br/assets/img/publisher/logo-publisher-square-1000.png",
          "contentUrl": "https://www.vitalegeo.com.br/assets/img/publisher/logo-publisher-square-1000.png",
          "width": 1000,
          "height": 1000,
          "caption": "VitaleGeo"
        },
        "sameAs": [
          "https://www.youtube.com/@vitalegeo",
          "https://github.com/vitaledev"
        ]
      }
    ]
  })} />

  <!-- Tipografia Oficial: Orbitron (Logótipo/Impacto), Montserrat (Corpo/Subtítulos) & JetBrains Mono (Dados/Telemetria) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=Orbitron:wght@700;800;900&display=swap" rel="stylesheet">
  
  <!-- Ícones Phosphor -->
  <script src="https://unpkg.com/@phosphor-icons/web" defer></script>

  <!-- Google AdSense Oficial -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6879770260785828" crossorigin="anonymous"></script>
</head>
<body class="page-shell bg-[#F5F2EB] text-[#0A192F] selection:bg-[#C8102E] selection:text-white antialiased relative overflow-x-hidden">
  <Header />
  
  <slot />

  <Footer />
</body>
</html>
