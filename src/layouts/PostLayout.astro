---
import Layout from './Layout.astro';
import TopoLines from '../components/TopoLines.astro';

interface Props {
  titulo: string;
  resumo: string;
  categoria: string;
  data: string;
  img: string;
  tempoLeitura?: string;
}

const {
  titulo,
  resumo,
  categoria,
  data,
  img,
  tempoLeitura = '5 min'
} = Astro.props;
---

<Layout
  title={`${titulo} | VitaleGeo`}
  description={resumo}
  image={img}
  type="article"
>
  <main class="page-content">
    <!-- Header do Artigo Minimalista -->
    <header class="relative pt-32 sm:pt-40 pb-10 px-6 border-b border-white/[0.05] overflow-hidden">
      <TopoLines strokeColor="#f59e0b" />

      <div class="max-w-4xl mx-auto relative z-10">
        <div class="flex flex-wrap items-center gap-2.5 mb-5">
          <a href="/blog" class="inline-flex items-center gap-1.5 text-xs font-mono text-slate-400 hover:text-white transition">
            <i class="ph-bold ph-arrow-left"></i> Dossiês
          </a>
          <span class="text-slate-700">·</span>
          <span class="category-pill">{categoria}</span>
          <span class="text-slate-700">·</span>
          <span class="text-xs font-mono text-slate-400">{tempoLeitura.toUpperCase()} LEITURA</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-heading font-medium text-white leading-[1.15] tracking-tight mb-5">
          {titulo}
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal mb-6 max-w-3xl">
          {resumo}
        </p>

        <div class="flex items-center gap-3 text-xs font-mono text-slate-400 border-t border-white/[0.05] pt-4">
          <span class="text-amber-400">{data}</span>
          <span class="text-slate-700">·</span>
          <span>VitaleGeo</span>
        </div>
      </div>
    </header>

    <!-- Imagem de Capa com Proporção Cartográfica 16:9 -->
    {img && (
      <div class="max-w-4xl mx-auto px-6 -mt-6 sm:-mt-8 mb-10 relative z-20">
        <div class="aspect-[16/9] overflow-hidden rounded-xl border border-white/10 shadow-2xl bg-slate-900 carto-corner-frame">
          <img
            src={img}
            alt={titulo}
            referrerpolicy="no-referrer"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    )}

    <!-- Corpo do Artigo em Tipografia Editorial Arejada -->
    <article class="px-6 pb-24 max-w-3xl mx-auto">
      <div class="article-body prose prose-invert prose-base sm:prose-lg max-w-none">
        <slot />
      </div>

      <!-- Bloco de Anúncio In-Article Oficial do AdSense com Container Reservado Anti-CLS -->
      <div class="my-14 pt-8 border-t border-white/[0.06] text-center min-h-[280px] flex flex-col justify-center">
        <ins class="adsbygoogle"
             style="display:block; text-align:center;"
             data-ad-layout="in-article"
             data-ad-format="fluid"
             data-ad-client="ca-pub-6879770260785828"
             data-ad-slot="5140105675"></ins>
        <script is:inline>
          (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>

      <!-- Rodapé do Artigo / Chamada para o YouTube -->
      <div class="mt-12 p-6 sm:p-8 rounded-xl bg-white/[0.02] border border-white/10 carto-corner-frame flex flex-col sm:flex-row items-center justify-between gap-5 shadow-sm">
        <div>
          <h3 class="text-base font-heading font-semibold text-white">Gostou deste dossiê?</h3>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Inscreva-se no canal Já Imaginou Isso para análises territoriais em 4K.</p>
        </div>
        <a href="https://www.youtube.com/@vitalegeo" target="_blank" rel="noopener noreferrer" class="btn-clean-primary flex-shrink-0" aria-label="Acessar o canal Já Imaginou Isso no YouTube">
          <i class="ph-fill ph-youtube-logo text-red-500 text-base"></i> Canal YouTube
        </a>
      </div>
    </article>
  </main>
</Layout>
