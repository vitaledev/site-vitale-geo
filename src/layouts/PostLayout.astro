---
import Layout from './Layout.astro';
import TopoLines from '../components/TopoLines.astro';

interface RelatedPost {
  slug: string;
  titulo: string;
  resumo: string;
  categoria: string;
  data: string;
  img: string;
  tempoLeitura?: string;
}

interface Props {
  titulo: string;
  resumo: string;
  categoria: string;
  data: string;
  img: string;
  tempoLeitura?: string;
  slug?: string;
  relatedPosts?: RelatedPost[];
}

const {
  titulo,
  resumo,
  categoria,
  data,
  img,
  tempoLeitura = '5 min',
  slug = '',
  relatedPosts = []
} = Astro.props;

const siteUrl = 'https://www.vitalegeo.com.br';
const canonicalUrl = slug ? `${siteUrl}/blog/${slug}/` : Astro.url.href;
const fullImgUrl = img.startsWith('http') ? img : `${siteUrl}${img.startsWith('/') ? '' : '/'}${img}`;
---

<Layout
  title={`${titulo} | VitaleGeo`}
  description={resumo}
  image={fullImgUrl}
  canonical={canonicalUrl}
  type="article"
>
  <!-- Schema.org JSON-LD para Artigo/Dossiê -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": titulo,
    "description": resumo,
    "image": fullImgUrl,
    "inLanguage": "pt-BR",
    "author": {
      "@type": "Person",
      "name": "Agnaldo Batista",
      "url": "https://www.vitalegeo.com.br/sobre/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "VitaleGeo",
      "url": "https://www.vitalegeo.com.br/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://www.vitalegeo.com.br/assets/img/publisher/logo-publisher-square-1000.png"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": canonicalUrl
    }
  })} />

  <main class="page-content">
    <!-- Header do Artigo Minimalista -->
    <header class="relative pt-32 sm:pt-40 pb-10 px-6 border-b border-white/[0.05] overflow-hidden">
      <TopoLines strokeColor="#f59e0b" />

      <div class="max-w-4xl mx-auto relative z-10">
        <div class="flex flex-wrap items-center gap-2.5 mb-5">
          <a href="/blog" class="inline-flex items-center gap-1.5 text-xs text-slate-400 hover:text-white transition">
            <i class="ph-bold ph-arrow-left"></i> Dossiês
          </a>
          <span class="text-slate-700">·</span>
          <span class="category-pill">{categoria}</span>
          <span class="text-slate-700">·</span>
          <span class="text-xs text-slate-400">{tempoLeitura} de leitura</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-heading font-medium text-white leading-[1.15] tracking-tight mb-5">
          {titulo}
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal mb-6 max-w-3xl">
          {resumo}
        </p>

        <div class="flex items-center gap-3 text-xs text-slate-400 border-t border-white/[0.05] pt-4">
          <span class="text-amber-400 font-medium">{data}</span>
          <span class="text-slate-700">·</span>
          <span>Por Agnaldo Batista</span>
          <span class="text-slate-700">·</span>
          <span>VitaleGeo</span>
        </div>
      </div>
    </header>

    <!-- Imagem de Capa com Proporção Cartográfica 16:9 -->
    {img && (
      <div class="max-w-4xl mx-auto px-6 -mt-6 sm:-mt-8 mb-10 relative z-20">
        <div class="aspect-[16/9] overflow-hidden rounded-xl border border-white/10 shadow-2xl bg-slate-900">
          <img
            src={img}
            alt={titulo}
            referrerpolicy="no-referrer"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    )}

    <!-- Corpo do Artigo em Tipografia Editorial Arejada -->
    <article class="px-6 pb-16 max-w-3xl mx-auto">
      <div class="article-body prose prose-invert prose-base sm:prose-lg max-w-none">
        <slot />
      </div>

      <!-- Bloco de Anúncio In-Article Oficial do AdSense com Container Reservado Anti-CLS -->
      <div class="my-14 pt-8 border-t border-white/[0.06] text-center min-h-[280px] flex flex-col justify-center">
        <ins class="adsbygoogle"
             style="display:block; text-align:center;"
             data-ad-layout="in-article"
             data-ad-format="fluid"
             data-ad-client="ca-pub-6879770260785828"
             data-ad-slot="5140105675"></ins>
        <script is:inline>
          (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>

      <!-- Rodapé do Artigo / Chamada para o YouTube -->
      <div class="mt-12 p-6 sm:p-8 rounded-xl bg-white/[0.02] border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-5 shadow-sm">
        <div>
          <h3 class="text-base font-heading font-semibold text-white">Gostou deste dossiê?</h3>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Inscreva-se no canal Já Imaginou Isso para análises territoriais em 4K.</p>
        </div>
        <a href="https://www.youtube.com/@vitalegeo" target="_blank" rel="noopener noreferrer" class="btn-clean-primary flex-shrink-0" aria-label="Acessar o canal Já Imaginou Isso no YouTube">
          <i class="ph-fill ph-youtube-logo text-red-500 text-base"></i> Canal YouTube
        </a>
      </div>
    </article>

    <!-- Seção de Dossiês Relacionados (Cross-Linking Interno para Retenção e SEO) -->
    {relatedPosts.length > 0 && (
      <section class="border-t border-white/[0.06] bg-white/[0.01] py-16 px-6">
        <div class="max-w-6xl mx-auto">
          <div class="flex items-baseline justify-between mb-8">
            <div>
              <span class="text-xs font-mono text-amber-400 uppercase tracking-wider">Leituras Recomendadas</span>
              <h2 class="text-2xl sm:text-3xl font-heading text-white font-bold tracking-tight mt-1">Continue Investigando</h2>
            </div>
            <a href="/blog" class="text-xs font-semibold text-amber-400 hover:text-white transition flex items-center gap-1">
              Ver todos os dossiês <i class="ph-bold ph-arrow-right text-xs"></i>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map(post => (
              <a href={`/blog/${post.slug}/`} class="editorial-card minimal-card group overflow-hidden flex flex-col justify-between h-full">
                <div>
                  <div class="aspect-[16/10] overflow-hidden bg-slate-900 relative">
                    <img
                      src={post.img}
                      alt={post.titulo}
                      loading="lazy"
                      referrerpolicy="no-referrer"
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-500 ease-out"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent pointer-events-none"></div>
                    <div class="absolute top-3 left-3">
                      <span class="category-pill text-amber-300 border-amber-400/20 bg-amber-950/70">
                        {post.categoria}
                      </span>
                    </div>
                    <div class="absolute bottom-3 right-3">
                      <span class="text-[10px] font-mono tracking-wider px-2 py-0.5 rounded-full bg-black/80 backdrop-blur text-slate-300 border border-white/10">
                        {post.tempoLeitura}
                      </span>
                    </div>
                  </div>
                  <div class="p-5">
                    <h3 class="text-base font-heading text-white group-hover:text-amber-400 transition mb-2 leading-snug font-semibold line-clamp-2">
                      {post.titulo}
                    </h3>
                    <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
                      {post.resumo}
                    </p>
                  </div>
                </div>
                <div class="px-5 pb-5 pt-0 text-xs font-semibold text-amber-400 flex items-center gap-1 group-hover:text-amber-300">
                  Ler dossiê <i class="ph-bold ph-arrow-right group-hover:translate-x-1 transition"></i>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</Layout>
