---
---
<footer class="site-footer">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex flex-col items-center justify-center">
      <div class="site-footer__social">
        <a href="https://github.com/vitaledev" target="_blank" rel="noopener noreferrer" class="hover:text-white transition" aria-label="GitHub">
          <i class="ph-bold ph-github-logo"></i>
        </a>
        <a href="https://www.youtube.com/@vitalegeo" target="_blank" rel="noopener noreferrer" class="hover:text-red-500 transition" aria-label="YouTube">
          <i class="ph-fill ph-youtube-logo"></i>
        </a>
      </div>

      <p class="site-footer__brand text-sm sm:text-base text-white">VitaleGeo</p>
      <p class="text-slate-400 text-xs max-w-sm mx-auto">
        Arquivo independente de inteligência cartográfica e investigações geopolíticas.
      </p>

      <div class="site-footer__links text-xs mt-4">
        <a href="/sobre/">Sobre o Projeto</a>
        <span class="text-slate-700">·</span>
        <a href="/politica/">Privacidade</a>
        <span class="text-slate-700">·</span>
        <a href="https://www.youtube.com/@vitalegeo" target="_blank" rel="noopener noreferrer">Canal YouTube</a>
      </div>

      <div class="mt-6 pt-6 border-t border-white/[0.04] w-full flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-2">
        <span>&copy; {new Date().getFullYear()} VitaleGeo</span>
        <span class="text-slate-600 hidden sm:inline">Observatório & Cartografia Independente</span>
        <span>Acesso Livre & Aberto</span>
      </div>
    </div>
  </div>
</footer>
