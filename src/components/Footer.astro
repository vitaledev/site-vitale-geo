---
---
<footer class="site-footer">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex flex-col items-center justify-center">
      <div class="site-footer__social">
        <a href="https://github.com/vitaledev" target="_blank" rel="noopener noreferrer" class="hover:text-white transition" aria-label="GitHub">
          <i class="ph-bold ph-github-logo"></i>
        </a>
        <a href="https://www.youtube.com/@vitalegeo" target="_blank" rel="noopener noreferrer" class="hover:text-[#C8102E] transition" aria-label="YouTube">
          <i class="ph-fill ph-youtube-logo text-xl"></i>
        </a>
      </div>

      <p class="site-footer__brand text-base sm:text-lg font-orbitron font-extrabold tracking-wider text-white">VITALEGEO</p>
      <p class="text-slate-400 text-xs max-w-sm mx-auto font-sans mt-1">
        Arquivo independente de inteligência cartográfica e investigações geopolíticas.
      </p>

      <div class="site-footer__links text-xs mt-4">
        <a href="/sobre/" class="hover:text-[#C8102E] transition">Sobre o Projeto</a>
        <span class="text-slate-600">·</span>
        <a href="/politica/" class="hover:text-[#C8102E] transition">Privacidade</a>
        <span class="text-slate-600">·</span>
        <a href="https://www.youtube.com/@vitalegeo" target="_blank" rel="noopener noreferrer" class="hover:text-[#C8102E] transition">Canal YouTube</a>
      </div>

      <div class="mt-6 pt-6 border-t border-white/[0.08] w-full flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 font-mono gap-2">
        <span>&copy; {new Date().getFullYear()} VITALEGEO</span>
        <span class="text-slate-500 hidden sm:inline">Observatório & Cartografia Independente</span>
        <span>Acesso Livre & Aberto</span>
      </div>
    </div>
  </div>
</footer>
