---
interface Props {
  className?: string;
  label?: string;
}
const { className = '', label = 'ESCALA CARTOGRÁFICA' } = Astro.props;
---
<div class={`inline-flex flex-col gap-1 select-none ${className}`} aria-label="Escala Gráfica Cartográfica">
  <div class="flex items-center justify-between text-[8px] font-mono font-medium text-[#53647C] tracking-wider uppercase">
    <span>{label}</span>
    <span class="text-[#0A192F]/40 font-mono">WGS 84</span>
  </div>
  
  <div class="flex items-center w-48 sm:w-56 h-2 border border-[#0A192F]/20 rounded-xs overflow-hidden bg-[#F5F2EB]">
    <!-- Segmento 0 - 50 km (Navy) -->
    <div class="w-1/6 h-full bg-[#0A192F]"></div>
    <!-- Segmento 50 - 100 km (Bege / Sage suave) -->
    <div class="w-1/6 h-full bg-[#A8C3A6]/40 border-r border-[#0A192F]/20"></div>
    <!-- Segmento 100 - 250 km (Navy) -->
    <div class="w-2/6 h-full bg-[#0A192F]"></div>
    <!-- Segmento 250 - 500 km (Bege Cartográfico) -->
    <div class="w-2/6 h-full bg-[#F5F2EB]"></div>
  </div>

  <div class="flex justify-between text-[8px] font-mono text-[#0A192F]/70 px-0.5">
    <span>0</span>
    <span>100</span>
    <span>250</span>
    <span>500 km</span>
  </div>
</div>
