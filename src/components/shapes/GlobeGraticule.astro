---
interface Props {
  size?: number;
  className?: string;
}
const { size = 120, className = '' } = Astro.props;
---
<div class={`inline-block select-none relative ${className}`} style={`width: ${size}px; height: ${size}px;`} aria-label="Globo Geométrico Quadriculado">
  <img src="/brand/shapes/globe-grid-minimal.svg" alt="" aria-hidden="true" class="w-full h-full object-contain" />
</div>
