---
interface Props {
  size?: number;
  className?: string;
}
const { size = 120, className = '' } = Astro.props;
---
<div class={`inline-block select-none relative ${className}`} style={`width: ${size}px; height: ${size}px;`} aria-label="Globo com Retícula Geodésica">
  <svg viewBox="0 0 500 500" class="w-full h-full" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Círculo Externo do Globo -->
    <circle cx="250" cy="250" r="200" stroke="#0A192F" stroke-width="2.5" fill="none"/>

    <!-- Eixo Terrestre Inclinado (23.5°) -->
    <line x1="170" y1="62" x2="330" y2="438" stroke="#C8102E" stroke-width="1.8" stroke-dasharray="5 4"/>
    <circle cx="170" cy="62" r="3" fill="#C8102E"/>
    <circle cx="330" cy="438" r="3" fill="#C8102E"/>
    <text x="145" y="55" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#C8102E">N (23.5°)</text>

    <!-- Equador -->
    <line x1="50" y1="250" x2="450" y2="250" stroke="#0A192F" stroke-width="2.0"/>

    <!-- Meridiano Central -->
    <line x1="250" y1="50" x2="250" y2="450" stroke="#0A192F" stroke-width="2.0"/>

    <!-- Paralelos -->
    <ellipse cx="250" cy="180" rx="187" ry="24" stroke="#0A192F" stroke-width="1.0" stroke-dasharray="4 4" opacity="0.5" fill="none"/>
    <ellipse cx="250" cy="120" rx="152" ry="18" stroke="#A8C3A6" stroke-width="1.2" opacity="0.85" fill="none"/>
    <ellipse cx="250" cy="75" rx="97" ry="12" stroke="#0A192F" stroke-width="1.0" stroke-dasharray="4 4" opacity="0.5" fill="none"/>

    <ellipse cx="250" cy="320" rx="187" ry="24" stroke="#0A192F" stroke-width="1.0" stroke-dasharray="4 4" opacity="0.5" fill="none"/>
    <ellipse cx="250" cy="380" rx="152" ry="18" stroke="#A8C3A6" stroke-width="1.2" opacity="0.85" fill="none"/>
    <ellipse cx="250" cy="425" rx="97" ry="12" stroke="#0A192F" stroke-width="1.0" stroke-dasharray="4 4" opacity="0.5" fill="none"/>

    <!-- Meridianos -->
    <ellipse cx="250" cy="250" rx="60" ry="200" stroke="#0A192F" stroke-width="1.0" opacity="0.55" fill="none"/>
    <ellipse cx="250" cy="250" rx="120" ry="200" stroke="#A8C3A6" stroke-width="1.2" opacity="0.85" fill="none"/>
    <ellipse cx="250" cy="250" rx="165" ry="200" stroke="#0A192F" stroke-width="1.0" opacity="0.55" fill="none"/>

    <!-- Nós de Interseção Geodésica -->
    <circle cx="250" cy="250" r="3" fill="#0A192F"/>
    <circle cx="310" cy="250" r="2" fill="#0A192F"/>
    <circle cx="190" cy="250" r="2" fill="#0A192F"/>
  </svg>
</div>
