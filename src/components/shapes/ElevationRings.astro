    <path d="M 250 85 C 345 80, 420 150, 415 250 C 410 350, 340 415, 248 420 C 145 425, 85 350, 90 250 C 95 145, 155 90, 250 85 Z" stroke="#0A192F" stroke-width="1.2" opacity="0.6" fill="none"/>
    <path d="M 250 120 C 325 115, 385 170, 380 250 C 375 330, 320 380, 250 385 C 170 390, 120 330, 125 250 C 130 165, 175 125, 250 120 Z" stroke="#A8C3A6" stroke-width="1.5" opacity="0.85" fill="none"/>
    <path d="M 250 155 C 305 150, 350 190, 345 250 C 340 310, 295 345, 250 350 C 190 355, 155 310, 160 250 C 165 185, 195 160, 250 155 Z" stroke="#0A192F" stroke-width="2.2" opacity="0.95" fill="none"/>
