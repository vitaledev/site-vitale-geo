    <ellipse cx="250" cy="250" rx="22" ry="18" stroke="#C8102E" stroke-width="1.8" stroke-dasharray="4 4" fill="none"/>
    <path d="M 244 250 L 256 250 M 250 244 L 250 256" stroke="#C8102E" stroke-width="2" stroke-linecap="round"/>
    <circle cx="250" cy="250" r="2.5" fill="#C8102E"/>
    <text x="262" y="254" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="700" fill="#C8102E">{elev}</text>
