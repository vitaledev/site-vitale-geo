---
interface Props {
  size?: number;
  className?: string;
  animate?: boolean;
}
const { size = 32, className = '', animate = false } = Astro.props;
---
<div class={`inline-block select-none relative ${className}`} style={`width: ${size}px; height: ${size}px;`} aria-label="Bússola Minimalista">
  <svg viewBox="0 0 120 120" class={`w-full h-full ${animate ? 'hover:rotate-45 transition-transform duration-500 ease-out' : ''}`} fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Anel Externo Fino -->
    <circle cx="60" cy="60" r="50" fill="none" stroke="#0A192F" stroke-width="1.2" stroke-opacity="0.5" />
    <circle cx="60" cy="60" r="42" fill="none" stroke="#0A192F" stroke-width="0.6" stroke-opacity="0.2" stroke-dasharray="2 4" />
    
    <!-- 4 Ticks Cardinais Precisos -->
    <line x1="60" y1="10" x2="60" y2="17" stroke="#C8102E" stroke-width="1.8" />
    <line x1="60" y1="103" x2="60" y2="110" stroke="#0A192F" stroke-width="1" stroke-opacity="0.5" />
    <line x1="10" y1="60" x2="17" y2="60" stroke="#0A192F" stroke-width="1" stroke-opacity="0.5" />
    <line x1="103" y1="60" x2="110" y2="60" stroke="#0A192F" stroke-width="1" stroke-opacity="0.5" />

    <!-- Indicador 'N' em Orbitron -->
    <text x="60" y="29" text-anchor="middle" font-family="'Orbitron', sans-serif" font-size="9" font-weight="700" fill="#C8102E" letter-spacing="1">N</text>

    <!-- Agulha Minimalista Precisa -->
    <!-- Ponta Norte (Vermelho) -->
    <polygon points="60,33 56.5,60 63.5,60" fill="#C8102E" />
    <!-- Ponta Sul (Navy Translúcido) -->
    <polygon points="60,87 56.5,60 63.5,60" fill="#0A192F" fill-opacity="0.25" />
    
    <!-- Pivot Central -->
    <circle cx="60" cy="60" r="2.5" fill="#0A192F" />
    <circle cx="60" cy="60" r="1" fill="#F5F2EB" />
  </svg>
</div>
