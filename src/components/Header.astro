---
interface Props {
  currentPath?: string;
}
const pathname = Astro.url.pathname;
---
<header>
  <!-- Floating Glass Pill Navbar para Desktop & Tablet -->
  <nav class="floating-pill-nav" aria-label="Navegação Principal">
    <div class="px-5 sm:px-6 h-14 sm:h-16 flex justify-between items-center w-full">
      <a href="/" class="flex items-center gap-2.5 group" aria-label="VitaleGeo Início">
        <div class="w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center text-[#0A192F] group-hover:text-[#C8102E] group-hover:scale-105 transition duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="w-full h-full" fill="none">
            <path stroke="currentColor" stroke-width="15" stroke-linecap="butt" stroke-linejoin="miter" d="M 193 63 A 92 92 0 1 0 220 128 L 154 128" />
            <rect x="123" y="14" width="10" height="20" rx="2" fill="currentColor"/>
            <rect x="123" y="222" width="10" height="20" rx="2" fill="currentColor"/>
            <rect x="14" y="123" width="20" height="10" rx="2" fill="currentColor"/>
            <ellipse cx="128" cy="128" rx="48" ry="92" stroke="currentColor" stroke-width="3" stroke-dasharray="6 5" opacity="0.4"/>
            <line x1="128" y1="36" x2="128" y2="220" stroke="currentColor" stroke-width="2.5" stroke-dasharray="5 5" opacity="0.35"/>
            <line x1="36" y1="128" x2="136" y2="128" stroke="currentColor" stroke-width="3" stroke-dasharray="6 5" opacity="0.4"/>
            <path fill="currentColor" d="M 74 76 L 94 76 L 118 156 L 142 76 L 162 76 L 128 180 C 124 190 112 190 108 180 Z"/>
          </svg>
        </div>
        <span class="text-base sm:text-lg font-orbitron font-black tracking-wider leading-none text-[#0A192F] group-hover:text-[#C8102E] transition">
          VITALEGEO
        </span>
      </a>
      
      <div class="hidden md:flex items-center gap-1 text-xs font-medium text-[#1F334E] bg-[#0A192F]/[0.04] p-1 rounded-full border border-[#0A192F]/10">
        <a href="/" class={`px-3.5 py-1.5 rounded-full transition ${pathname === '/' ? 'text-white bg-[#0A192F] font-semibold shadow-sm' : 'hover:text-[#0A192F] hover:bg-[#0A192F]/5'}`}>Início</a>
        <a href="/blog/" class={`px-3.5 py-1.5 rounded-full transition ${pathname.startsWith('/blog') ? 'text-white bg-[#0A192F] font-semibold shadow-sm' : 'hover:text-[#0A192F] hover:bg-[#0A192F]/5'}`}>Posts</a>
        <a href="/ferramentas/" class={`px-3.5 py-1.5 rounded-full transition ${pathname.startsWith('/ferramentas') ? 'text-white bg-[#0A192F] font-semibold shadow-sm' : 'hover:text-[#0A192F] hover:bg-[#0A192F]/5'}`}>Ferramentas</a>
        <a href="/jogos/" class={`px-3.5 py-1.5 rounded-full transition ${pathname.startsWith('/jogos') ? 'text-white bg-[#0A192F] font-semibold shadow-sm' : 'hover:text-[#0A192F] hover:bg-[#0A192F]/5'}`}>Jogos</a>
        <a href="/videos/" class={`px-3.5 py-1.5 rounded-full transition ${pathname.startsWith('/videos') ? 'text-white bg-[#0A192F] font-semibold shadow-sm' : 'hover:text-[#0A192F] hover:bg-[#0A192F]/5'}`}>Vídeos</a>
        <a href="/sobre/" class={`px-3.5 py-1.5 rounded-full transition ${pathname.startsWith('/sobre') ? 'text-white bg-[#0A192F] font-semibold shadow-sm' : 'hover:text-[#0A192F] hover:bg-[#0A192F]/5'}`}>Sobre</a>
      </div>

      <a href="https://www.youtube.com/@vitalegeo" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold text-[#C8102E] hover:text-white bg-[#C8102E]/10 hover:bg-[#C8102E] border border-[#C8102E]/25 px-3.5 py-1.5 rounded-full transition shadow-sm" aria-label="Canal no YouTube">
        <i class="ph-fill ph-youtube-logo text-sm"></i> YouTube
      </a>
    </div>
  </nav>

  <!-- Mobile Bottom Navigation Bar -->
  <div class="h-16 md:hidden"></div>
  <nav class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-[#F5F2EB]/95 backdrop-blur-lg border-t border-[#0A192F]/10 py-2 px-1.5 shadow-[0_-4px_20px_rgba(10,25,47,0.06)]" aria-label="Navegação Mobile">
    <div class="grid grid-cols-6 items-center text-center text-[10px] sm:text-[11px] font-medium text-[#53647C]">
      <a href="/" class={`flex flex-col items-center gap-0.5 ${pathname === '/' ? 'text-[#C8102E] font-semibold' : 'hover:text-[#0A192F] transition'}`}>
        <i class="ph-bold ph-house text-base"></i> <span class="truncate">Início</span>
      </a>
      <a href="/blog/" class={`flex flex-col items-center gap-0.5 ${pathname.startsWith('/blog') ? 'text-[#C8102E] font-semibold' : 'hover:text-[#0A192F] transition'}`}>
        <i class="ph-bold ph-newspaper text-base"></i> <span class="truncate">Posts</span>
      </a>
      <a href="/ferramentas/" class={`flex flex-col items-center gap-0.5 ${pathname.startsWith('/ferramentas') ? 'text-[#0A192F] font-semibold' : 'hover:text-[#0A192F] transition'}`}>
        <i class="ph-bold ph-compass text-base"></i> <span class="truncate">Ferramentas</span>
      </a>
      <a href="/jogos/" class={`flex flex-col items-center gap-0.5 ${pathname.startsWith('/jogos') ? 'text-[#0A192F] font-semibold' : 'hover:text-[#0A192F] transition'}`}>
        <i class="ph-bold ph-game-controller text-base"></i> <span class="truncate">Jogos</span>
      </a>
      <a href="/videos/" class={`flex flex-col items-center gap-0.5 ${pathname.startsWith('/videos') ? 'text-[#C8102E] font-semibold' : 'hover:text-[#0A192F] transition'}`}>
        <i class="ph-bold ph-play-circle text-base"></i> <span class="truncate">Vídeos</span>
      </a>
      <a href="/sobre/" class={`flex flex-col items-center gap-0.5 ${pathname.startsWith('/sobre') ? 'text-[#0A192F] font-semibold' : 'hover:text-[#0A192F] transition'}`}>
        <i class="ph-bold ph-info text-base"></i> <span class="truncate">Sobre</span>
      </a>
    </div>
  </nav>
</header>
