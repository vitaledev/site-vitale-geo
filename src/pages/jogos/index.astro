---
import Layout from '../../layouts/Layout.astro';
import TopoLines from '../../components/TopoLines.astro';
import GamesArchive from '../../components/react/GamesArchive';
import { gamesDB } from '../../data/games';

const canonicalUrl = 'https://www.vitalegeo.com.br/jogos/';
---

<Layout
  title="Desafios de Fronteira & Território | VitaleGeo"
  description="Módulos interativos e desafios de geografia mundial: identifique fronteiras, capitais, bandeiras, PIB e distâncias no mapa mudo."
  canonical={canonicalUrl}
>
  <!-- Schema.org CollectionPage JSON-LD -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": "https://www.vitalegeo.com.br/jogos/#collection",
    "url": canonicalUrl,
    "name": "Desafios de Fronteira & Território | VitaleGeo",
    "description": "Módulos interativos e desafios de geografia mundial.",
    "isPartOf": {
      "@id": "https://www.vitalegeo.com.br/#website"
    }
  })} />

  <main class="page-content">
    <header class="relative pt-36 sm:pt-44 pb-12 px-6 text-center overflow-hidden">
      <TopoLines strokeColor="#10b981" />

      <div class="max-w-3xl mx-auto relative z-10">
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-heading font-bold text-white tracking-tight leading-tight">
          Desafios de Fronteira
        </h1>
        <p class="text-sm sm:text-base text-slate-300 mt-3 max-w-xl mx-auto font-normal leading-relaxed">
          Módulos interativos para identificar limites soberanos, estreitos estratégicos e capitais geopolíticas no mapa.
        </p>
      </div>
    </header>

    <!-- Transição Editorial -->
    <div class="max-w-6xl mx-auto px-6 mb-6">
      <div class="h-px bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
    </div>

    <!-- Grade Oficial de Simulações com Filtro em Hover e Busca -->
    <section class="py-2 px-6 max-w-6xl mx-auto pb-16">
      <GamesArchive client:load games={gamesDB} />
    </section>

    <!-- Transição Editorial -->
    <div class="max-w-6xl mx-auto px-6 mb-12">
      <div class="h-px bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
    </div>

    <!-- Seção Editorial: Como Funcionam os Desafios -->
    <section class="px-6 max-w-4xl mx-auto pb-16">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-heading text-white font-bold tracking-tight">
          A Ciência por Trás das Simulações
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-2 max-w-xl mx-auto">
          Por que aprender limites territoriais jogando é o método mais eficiente de fixação espacial.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm leading-relaxed text-slate-300">
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5">
          <div class="w-8 h-8 rounded-lg bg-emerald-400/10 text-emerald-400 flex items-center justify-center mb-4">
            <i class="ph-bold ph-compass text-lg"></i>
          </div>
          <h3 class="text-base font-heading font-semibold text-white mb-2">Eliminação da Distorção Mercator</h3>
          <p class="text-slate-400 text-xs sm:text-sm">
            Mapas planos escolares esticam países próximos aos polos e encolhem regiões tropicais. Nossos desafios usam distâncias geodésicas esféricas reais para forçar você a recalibrar sua intuição visual sobre o tamanho de continentes.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/5">
          <div class="w-8 h-8 rounded-lg bg-emerald-400/10 text-emerald-400 flex items-center justify-center mb-4">
            <i class="ph-bold ph-target text-lg"></i>
          </div>
          <h3 class="text-base font-heading font-semibold text-white mb-2">Memória Muscular no Mapa Mudo</h3>
          <p class="text-slate-400 text-xs sm:text-sm">
            Identificar um enclave ou estreito sem fronteiras desenhadas ou nomes escritos ativa o raciocínio topológico profundo, criando pontes duradouras entre geopolítica documental e a geografia física real.
          </p>
        </div>
      </div>
    </section>

    <!-- Transição Editorial -->
    <div class="max-w-6xl mx-auto px-6 mb-12">
      <div class="h-px bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
    </div>

    <!-- Seção: Posts Recomendados para Dominar os Jogos -->
    <section class="px-6 max-w-6xl mx-auto pb-24">
      <div class="flex items-baseline justify-between mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-heading text-white font-bold tracking-tight">Posts Recomendados</h2>
        </div>
        <a href="/blog/" class="text-xs font-semibold text-amber-400 hover:text-white transition flex items-center gap-1">
          Ver acervo completo <i class="ph-bold ph-arrow-right text-xs"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/blog/ceuta-e-melilla/" class="editorial-card minimal-card group overflow-hidden flex flex-col justify-between h-full">
          <div class="p-5">
            <span class="category-pill text-amber-300 border-amber-400/20 bg-amber-950/70 mb-3 inline-block">Fronteiras</span>
            <h3 class="text-base font-heading text-white group-hover:text-amber-400 transition mb-2 font-semibold">Ceuta e Melilla</h3>
            <p class="text-xs text-slate-400 line-clamp-2">Entenda por que a Espanha controla dois enclaves soberanos no norte da África.</p>
          </div>
          <div class="px-5 pb-5 pt-0 text-xs font-semibold text-amber-400 flex items-center gap-1 group-hover:text-amber-300">
            Ler post <i class="ph-bold ph-arrow-right group-hover:translate-x-1 transition"></i>
          </div>
        </a>

        <a href="/blog/estreito-de-ormuz/" class="editorial-card minimal-card group overflow-hidden flex flex-col justify-between h-full">
          <div class="p-5">
            <span class="category-pill text-amber-300 border-amber-400/20 bg-amber-950/70 mb-3 inline-block">Geopolítica</span>
            <h3 class="text-base font-heading text-white group-hover:text-amber-400 transition mb-2 font-semibold">Estreito de Ormuz</h3>
            <p class="text-xs text-slate-400 line-clamp-2">A passagem naval por onde escoa 20% do petróleo mundial entre Omã e o Irã.</p>
          </div>
          <div class="px-5 pb-5 pt-0 text-xs font-semibold text-amber-400 flex items-center gap-1 group-hover:text-amber-300">
            Ler post <i class="ph-bold ph-arrow-right group-hover:translate-x-1 transition"></i>
          </div>
        </a>

        <a href="/blog/desaparecimento-mar-de-aral/" class="editorial-card minimal-card group overflow-hidden flex flex-col justify-between h-full">
          <div class="p-5">
            <span class="category-pill text-amber-300 border-amber-400/20 bg-amber-950/70 mb-3 inline-block">Desastres</span>
            <h3 class="text-base font-heading text-white group-hover:text-amber-400 transition mb-2 font-semibold">Desaparecimento do Mar de Aral</h3>
            <p class="text-xs text-slate-400 line-clamp-2">Como o 4º maior lago do mundo entre Cazaquistão e Uzbequistão virou deserto.</p>
          </div>
          <div class="px-5 pb-5 pt-0 text-xs font-semibold text-amber-400 flex items-center gap-1 group-hover:text-amber-300">
            Ler post <i class="ph-bold ph-arrow-right group-hover:translate-x-1 transition"></i>
          </div>
        </a>
      </div>
    </section>
  </main>
</Layout>
