---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import TopoLines from '../components/TopoLines.astro';
import HomeBlogFilter from '../components/react/HomeBlogFilter';
import { toolsDB } from '../data/tools';
import { gamesDB } from '../data/games';
import { videosLongos } from '../data/videos';

const allPosts = await getCollection('blog');
const postsData = allPosts.map(p => ({
  id: p.id,
  slug: p.id,
  titulo: p.data.titulo,
  resumo: p.data.resumo,
  categoria: p.data.categoria,
  data: p.data.data,
  img: p.data.img,
  tempoLeitura: p.data.tempoLeitura,
}));
---

<Layout
  title="VitaleGeo | Geopolítica, Fronteiras & Cartografia"
  description="Investigações territoriais, anomalias de fronteiras, rotas navais estratégicas e simuladores de escala real."
>
  <main class="page-content">
    <!-- Hero Editorial Minimalista e Arejado -->
    <header class="relative pt-36 sm:pt-44 pb-16 px-6 text-center overflow-hidden">
      <TopoLines strokeColor="#f59e0b" />

      <div class="max-w-4xl mx-auto relative z-10">
        <!-- Telemetria Cartográfica Discreta -->
        <div class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[0.2em] text-amber-400/90 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span>Atlas Territorial & Cartografia</span>
        </div>

        <h1 class="text-4xl sm:text-6xl md:text-7xl font-heading font-medium text-white max-w-4xl mx-auto leading-[1.12] tracking-tight">
          Geopolítica, fronteiras e a verdadeira escala do mundo.
        </h1>
        
        <p class="text-base sm:text-lg text-slate-300 max-w-xl mx-auto font-normal leading-relaxed mt-5 mb-8">
          Investigações territoriais, rotas marítimas estratégicas e as anomalias geográficas que os mapas convencionais omitem.
        </p>
        
        <div class="flex items-center justify-center gap-3">
          <a href="/blog" class="btn-clean-primary">
            Explorar Dossiês <i class="ph-bold ph-arrow-right text-xs"></i>
          </a>
          <a href="/ferramentas" class="btn-clean-secondary">
            <i class="ph-bold ph-compass text-sky-400"></i> Simuladores
          </a>
        </div>
      </div>
    </header>

    <!-- Divisor Cartográfico com Régua de Escala -->
    <div class="max-w-6xl mx-auto px-6 my-6">
      <div class="carto-divider">
        <div class="carto-divider-line"></div>
        <div class="carto-scale-bar">
          <span class="carto-scale-bar-line"></span>
          <span>500 km</span>
        </div>
        <div class="carto-divider-line"></div>
      </div>
    </div>

    <!-- Seção: Dossiês Recentes (Ilha React) -->
    <section class="py-12 px-6 max-w-6xl mx-auto">
      <div class="flex items-baseline justify-between mb-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-heading text-white font-semibold">Dossiês em Destaque</h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Investigações sobre limites soberanos e disputas territoriais.</p>
        </div>
        <a href="/blog" class="text-xs font-semibold text-amber-400 hover:text-white transition flex items-center gap-1">
          Ver acervo ({postsData.length}) <i class="ph-bold ph-arrow-right text-xs"></i>
        </a>
      </div>

      <!-- Ilha de React: Filtro Dinâmico com Cards Limpos -->
      <HomeBlogFilter client:load posts={postsData} />
    </section>

    <!-- Divisor Cartográfico -->
    <div class="max-w-6xl mx-auto px-6 my-6">
      <div class="carto-divider">
        <div class="carto-divider-line"></div>
        <div class="carto-scale-bar">
          <span class="carto-scale-bar-line"></span>
          <span>1:50.000.000</span>
        </div>
        <div class="carto-divider-line"></div>
      </div>
    </div>

    <!-- Seção: Ferramentas de Escala -->
    <section class="py-12 px-6 max-w-6xl mx-auto">
      <div class="flex items-baseline justify-between mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-heading text-white font-semibold">Instrumentos de Escala</h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Comparação de projeções e dimensões territoriais reais.</p>
        </div>
        <a href="/ferramentas" class="text-xs font-semibold text-sky-400 hover:text-white transition flex items-center gap-1">
          Ver todas <i class="ph-bold ph-arrow-right text-xs"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {toolsDB.slice(0, 3).map(tool => (
          <a href={tool.link} class="minimal-card carto-corner-frame carto-corner-frame-cyan group overflow-hidden flex flex-col justify-between h-full">
            <div>
              {tool.cover ? (
                <div class="aspect-[16/10] overflow-hidden bg-slate-900 relative">
                  <img src={tool.cover} alt={tool.titulo} class="w-full h-full object-cover group-hover:scale-105 transition duration-500 ease-out" />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent pointer-events-none"></div>
                  <div class="absolute top-3 left-3">
                    <span class="category-pill text-sky-300 border-sky-400/20 bg-sky-950/70">
                      <i class="ph-bold ph-compass"></i> SIMULADOR
                    </span>
                  </div>
                </div>
              ) : null}
              <div class="p-5">
                <h3 class="text-base sm:text-lg font-heading text-white group-hover:text-sky-400 transition mb-1.5 leading-snug font-semibold">{tool.titulo}</h3>
                <p class="text-xs sm:text-sm text-slate-400 line-clamp-2 leading-relaxed">{tool.desc}</p>
              </div>
            </div>
            <div class="px-5 pb-5 pt-0 text-xs font-semibold text-sky-400 flex items-center gap-1 group-hover:text-sky-300">
              Acessar simulador <i class="ph-bold ph-arrow-right group-hover:translate-x-1 transition"></i>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Divisor Cartográfico -->
    <div class="max-w-6xl mx-auto px-6 my-6">
      <div class="carto-divider">
        <div class="carto-divider-line"></div>
        <div class="carto-scale-bar">
          <span class="carto-scale-bar-line"></span>
          <span>COORDENADAS</span>
        </div>
        <div class="carto-divider-line"></div>
      </div>
    </div>

    <!-- Seção: Simulações & Desafios -->
    <section class="py-12 px-6 max-w-6xl mx-auto">
      <div class="flex items-baseline justify-between mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-heading text-white font-semibold">Desafios de Fronteira</h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Módulos interativos de reconhecimento territorial e soberania.</p>
        </div>
        <a href="/jogos" class="text-xs font-semibold text-emerald-400 hover:text-white transition flex items-center gap-1">
          Ver todos <i class="ph-bold ph-arrow-right text-xs"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {gamesDB.slice(0, 3).map(game => (
          <a href={game.link} class="minimal-card carto-corner-frame group overflow-hidden flex flex-col justify-between h-full">
            <div>
              {game.cover ? (
                <div class="aspect-[16/10] overflow-hidden bg-slate-900 relative">
                  <img src={game.cover} alt={game.titulo} class="w-full h-full object-cover group-hover:scale-105 transition duration-500 ease-out" />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent pointer-events-none"></div>
                  <div class="absolute top-3 left-3">
                    <span class="category-pill text-emerald-300 border-emerald-400/20 bg-emerald-950/70">
                      <i class="ph-bold ph-game-controller"></i> DESAFIO
                    </span>
                  </div>
                </div>
              ) : null}
              <div class="p-5">
                <h3 class="text-base sm:text-lg font-heading text-white group-hover:text-emerald-400 transition mb-1.5 leading-snug font-semibold">{game.titulo}</h3>
                <p class="text-xs sm:text-sm text-slate-400 line-clamp-2 leading-relaxed">{game.desc}</p>
              </div>
            </div>
            <div class="px-5 pb-5 pt-0 text-xs font-semibold text-emerald-400 flex items-center gap-1 group-hover:text-emerald-300">
              Iniciar desafio <i class="ph-bold ph-arrow-right group-hover:translate-x-1 transition"></i>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Divisor Cartográfico -->
    <div class="max-w-6xl mx-auto px-6 my-6">
      <div class="carto-divider">
        <div class="carto-divider-line"></div>
        <div class="carto-scale-bar">
          <span class="carto-scale-bar-line"></span>
          <span>4K UHD</span>
        </div>
        <div class="carto-divider-line"></div>
      </div>
    </div>

    <!-- Seção: Vídeos do Canal -->
    <section class="py-12 px-6 max-w-6xl mx-auto pb-24">
      <div class="flex items-baseline justify-between mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-heading text-white font-semibold">Vídeos & Documentários</h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-1">Análises cartográficas produzidas para o canal Já Imaginou Isso.</p>
        </div>
        <a href="/videos" class="text-xs font-semibold text-red-400 hover:text-white transition flex items-center gap-1">
          Ver galeria <i class="ph-bold ph-arrow-right text-xs"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {videosLongos.slice(0, 3).map(video => (
          <a href={video.link} target="_blank" rel="noopener noreferrer" class="minimal-card carto-corner-frame group overflow-hidden block">
            <div class="aspect-video relative bg-slate-900 overflow-hidden">
              <img
                src={`https://img.youtube.com/vi/${video.id}/maxresdefault.jpg`}
                alt={video.titulo}
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500 ease-out"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/10 transition">
                <div class="w-10 h-10 rounded-full bg-white/90 text-black flex items-center justify-center shadow-lg group-hover:scale-110 transition duration-300">
                  <i class="ph-fill ph-play text-lg ml-0.5 text-red-600"></i>
                </div>
              </div>
            </div>
            <div class="p-4">
              <h3 class="text-sm sm:text-base font-heading text-white group-hover:text-amber-400 transition line-clamp-2 leading-snug font-semibold">
                {video.titulo}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
