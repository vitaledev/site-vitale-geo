---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 — Território Não Mapeado | VitaleGeo"
  description="As coordenadas solicitadas não constam em nossos registros cartográficos."
>
  <main class="page-content flex flex-col items-center justify-center text-center px-6 pt-44 pb-24 min-h-[70vh]">
    <div class="max-w-xl mx-auto">
      <div class="text-7xl font-mono text-amber-400 font-bold mb-4 tracking-tight">404</div>
      <h1 class="text-3xl sm:text-5xl font-heading font-semibold text-white tracking-tight mb-4">
        Território Não Mapeado
      </h1>
      <p class="text-slate-300 text-base sm:text-lg mb-10 leading-relaxed font-normal">
        As coordenadas solicitadas não constam em nossos registros cartográficos ou o setor foi desmilitarizado.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-clean-primary">
          <i class="ph-bold ph-house"></i> Retornar ao Início
        </a>
        <a href="/blog" class="btn-clean-secondary">
          Explorar Dossiês
        </a>
      </div>
    </div>
  </main>
</Layout>
