---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { parsePostDate } from '../utils/dates';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => parsePostDate(b.data.data) - parsePostDate(a.data.data))
  .slice(0, 3);
---

<Layout
  title="404 — Página Não Encontrada | VitaleGeo"
  description="O conteúdo que você procura não foi encontrado ou o link pode ter mudado."
>
  <main class="page-content flex flex-col items-center justify-center text-center px-6 pt-44 pb-24 min-h-[70vh]">
    <div class="max-w-xl mx-auto">
      <div class="text-7xl font-mono text-[#C8102E] font-bold mb-4 tracking-tight">404</div>
      <h1 class="text-3xl sm:text-5xl font-heading font-semibold text-[#0A192F] tracking-tight mb-4">
        Página Não Encontrada
      </h1>
      <p class="text-[#1F334E] text-base sm:text-lg mb-10 leading-relaxed font-normal">
        O endereço solicitado não foi encontrado ou o conteúdo pode ter sido movido.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-clean-primary">
          <i class="ph-bold ph-house"></i> Retornar ao Início
        </a>
        <a href="/blog/" class="btn-clean-secondary">
          Ver Posts
        </a>
        <a href="/ferramentas/" class="btn-clean-secondary">
          Explorar ferramentas
        </a>
        <a href="/jogos/" class="btn-clean-secondary">
          Jogar
        </a>
      </div>
      <section class="mt-12 text-left">
        <h2 class="text-lg font-heading font-semibold text-[#0A192F] mb-4">Posts recentes</h2>
        <ul class="divide-y divide-[#0A192F]/10 border-y border-[#0A192F]/10">
          {recentPosts.map(post => (
            <li>
              <a href={`/blog/${post.id}/`} class="flex items-center justify-between gap-4 py-3 text-sm text-[#1F334E] hover:text-[#C8102E] transition">
                <span>{post.data.titulo}</span>
                <i class="ph-bold ph-arrow-up-right shrink-0" aria-hidden="true"></i>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
</Layout>
