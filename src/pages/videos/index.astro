---
import Layout from '../../layouts/Layout.astro';
import TopoLines from '../../components/TopoLines.astro';
import { videosLongos, videosShorts } from '../../data/videos';

const featuredVideo = videosLongos[0];
---

<Layout
  title="Vídeos & Documentários em 4K | VitaleGeo"
  description="Análises cartográficas e narrativas geopolíticas produzidas em 4K para o canal Já Imaginou Isso."
>
  <main class="page-content">
    <header class="relative pt-36 sm:pt-44 pb-12 px-6 overflow-hidden">
      <TopoLines strokeColor="#ef4444" />

      <div class="max-w-6xl mx-auto relative z-10">
        <div class="max-w-2xl mb-8">
          <div class="inline-flex items-center gap-2 text-[11px] font-mono uppercase tracking-[0.2em] text-red-400 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
            <span>Canal Já Imaginou Isso</span>
          </div>
          <h1 class="text-3xl sm:text-5xl md:text-6xl font-heading font-medium text-white tracking-tight leading-tight">
            Vídeos & Documentários em 4K
          </h1>
          <p class="text-sm sm:text-base text-slate-300 mt-3 font-normal leading-relaxed">
            Análises visuais de rotas marítimas estratégicas, anomalias de fronteira e o tabuleiro geopolítico global.
          </p>
        </div>

        <!-- Vídeo em Destaque Principal -->
        {featuredVideo && (
          <div class="aspect-video max-w-4xl rounded-xl overflow-hidden border border-white/10 shadow-2xl bg-black carto-corner-frame">
            <iframe
              class="w-full h-full"
              src={`https://www.youtube.com/embed/${featuredVideo.id}`}
              title={featuredVideo.titulo}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        )}
      </div>
    </header>

    <!-- Divisor Cartográfico com Escala -->
    <div class="max-w-6xl mx-auto px-6 mb-8">
      <div class="carto-divider">
        <div class="carto-divider-line"></div>
        <div class="carto-scale-bar">
          <span class="carto-scale-bar-line" style="border-color: #ef4444;"></span>
          <span style="color: #ef4444;">Documentários</span>
        </div>
        <div class="carto-divider-line"></div>
      </div>
    </div>

    <!-- Galeria de Documentários Longos -->
    <section class="py-6 px-6 max-w-6xl mx-auto">
      <div class="mb-8">
        <h2 class="text-xl sm:text-2xl font-heading text-white font-semibold">Análises Completas</h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Investigações temáticas produzidas em resolução 4K.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {videosLongos.slice(1).map(video => (
          <a href={video.link} target="_blank" rel="noopener noreferrer" class="minimal-card carto-corner-frame group overflow-hidden block">
            <div class="aspect-video relative bg-slate-900 overflow-hidden">
              <img
                src={`https://img.youtube.com/vi/${video.id}/maxresdefault.jpg`}
                alt={video.titulo}
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500 ease-out"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/10 transition">
                <div class="w-10 h-10 rounded-full bg-white/90 text-black flex items-center justify-center shadow-lg group-hover:scale-110 transition duration-300">
                  <i class="ph-fill ph-play text-lg ml-0.5 text-red-600"></i>
                </div>
              </div>
            </div>
            <div class="p-4">
              <h3 class="text-sm sm:text-base font-heading text-white group-hover:text-amber-400 transition line-clamp-2 leading-snug font-semibold">
                {video.titulo}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Divisor Cartográfico com Escala -->
    <div class="max-w-6xl mx-auto px-6 my-8">
      <div class="carto-divider">
        <div class="carto-divider-line"></div>
        <div class="carto-scale-bar">
          <span class="carto-scale-bar-line" style="border-color: #f59e0b;"></span>
          <span style="color: #f59e0b;">60s Shorts</span>
        </div>
        <div class="carto-divider-line"></div>
      </div>
    </div>

    <!-- Galeria de Shorts -->
    <section class="py-6 px-6 max-w-6xl mx-auto pb-24">
      <div class="mb-8">
        <h2 class="text-xl sm:text-2xl font-heading text-white font-semibold">Shorts & Curiosidades Rápidas</h2>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">Pílulas geopolíticas verticais de 60 segundos.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {videosShorts.slice(0, 15).map(short => (
          <a href={short.link} target="_blank" rel="noopener noreferrer" class="minimal-card carto-corner-frame group overflow-hidden block">
            <div class="aspect-[9/16] relative bg-slate-900 overflow-hidden">
              <img
                src={`https://img.youtube.com/vi/${short.id}/hqdefault.jpg`}
                alt={short.titulo}
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500 ease-out"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/10 transition">
                <div class="w-8 h-8 rounded-full bg-white/90 text-black flex items-center justify-center shadow-lg group-hover:scale-110 transition duration-300">
                  <i class="ph-fill ph-play text-base ml-0.5 text-red-600"></i>
                </div>
              </div>
            </div>
            <div class="p-3">
              <h4 class="text-xs font-heading text-white group-hover:text-amber-400 transition line-clamp-2 leading-snug">
                {short.titulo}
              </h4>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
