---
import Layout from '../../layouts/Layout.astro';
import TopoLines from '../../components/TopoLines.astro';
import VideosArchive from '../../components/react/VideosArchive';
import { videosLongos, videosShorts } from '../../data/videos';

const canonicalUrl = 'https://www.vitalegeo.com.br/videos/';
---

<Layout
  title="Vídeos & Documentários em 4K | VitaleGeo"
  description="Análises cartográficas e narrativas geopolíticas em 4K do canal oficial VitaleGeo organizadas em camadas com carregamento ultraleve."
  canonical={canonicalUrl}
>
  <main class="page-content">
    <header class="relative pt-36 sm:pt-44 pb-8 px-6 overflow-hidden">
      <TopoLines strokeColor="#ef4444" />

      <div class="max-w-6xl mx-auto relative z-10">
        <div class="max-w-3xl mb-4">
          <div class="flex items-center gap-2 mb-3">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            <span class="text-xs font-mono font-semibold tracking-widest uppercase text-red-400">
              Canal Oficial VitaleGeo
            </span>
          </div>
          <h1 class="text-3xl sm:text-5xl md:text-6xl font-heading font-bold text-white tracking-tight leading-tight">
            Vídeos & Documentários
          </h1>
          <p class="text-sm sm:text-base text-slate-300 mt-3 font-normal leading-relaxed">
            Investigações de rotas estratégicas, fronteiras anômalas e geopolítica mundial estruturadas em camadas para máxima velocidade.
          </p>
        </div>
      </div>
    </header>

    <!-- Transição Editorial -->
    <div class="max-w-6xl mx-auto px-6 mb-8">
      <div class="h-px bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
    </div>

    <!-- Catálogo de Vídeos em Camadas -->
    <section class="py-2 px-6 max-w-6xl mx-auto pb-24">
      <VideosArchive client:load videosLongos={videosLongos} videosShorts={videosShorts} />
    </section>
  </main>
</Layout>
