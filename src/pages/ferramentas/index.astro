---
import Layout from '../../layouts/Layout.astro';
import TopoLines from '../../components/TopoLines.astro';
import CompassRose from '../../components/shapes/CompassRose.astro';
import ScaleBar from '../../components/shapes/ScaleBar.astro';
import ToolsArchive from '../../components/react/ToolsArchive';
import { toolsDB } from '../../data/tools';

const canonicalUrl = 'https://www.vitalegeo.com.br/ferramentas/';
---

<Layout
  title="Instrumentos de Escala & Projeção | VitaleGeo"
  description="Simuladores de projeção, comparadores de escala territorial e métricas geoespaciais interativas organizadas por categoria e busca."
  canonical={canonicalUrl}
>
  <main class="page-content">
    <header class="relative pt-36 sm:pt-44 pb-12 px-6 text-center overflow-hidden">
      <TopoLines strokeColor="#A8C3A6" />

      <div class="max-w-3xl mx-auto relative z-10">
        <div class="inline-flex items-center gap-4 mb-4">
          <CompassRose size={28} animate={true} />
          <ScaleBar className="hidden sm:inline-flex" label="CALIBRAÇÃO DE PROJEÇÃO" />
        </div>
        <h1 class="text-3xl sm:text-5xl md:text-6xl font-heading font-bold text-[#0A192F] tracking-tight leading-tight">
          Instrumentos de Escala
        </h1>
        <p class="text-sm sm:text-base text-[#1F334E] mt-3 max-w-xl mx-auto font-normal leading-relaxed">
          Simuladores interativos para comparar a área real de países, analisar a distorção de Mercator e calcular distâncias geodésicas.
        </p>
      </div>
    </header>

    <!-- Transição Editorial -->
    <div class="max-w-6xl mx-auto px-6 mb-6">
      <div class="h-px bg-gradient-to-r from-transparent via-[#0A192F]/10 to-transparent"></div>
    </div>

    <!-- Seção de Ferramentas com Filtro por Categoria em Hover e Busca Rápida -->
    <section class="py-2 px-6 max-w-6xl mx-auto pb-24">
      <ToolsArchive client:load tools={toolsDB} />
    </section>
  </main>
</Layout>
