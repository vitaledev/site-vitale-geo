---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TopoLines from '../../components/TopoLines.astro';
import BlogArchive from '../../components/react/BlogArchive';
import { parsePostDate } from '../../utils/dates';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => parsePostDate(b.data.data) - parsePostDate(a.data.data));
const postsData = sortedPosts.map(p => ({
  id: p.id,
  slug: p.id,
  titulo: p.data.titulo,
  resumo: p.data.resumo,
  categoria: p.data.categoria,
  data: p.data.data,
  img: p.data.img,
  tempoLeitura: p.data.tempoLeitura,
}));
---

<Layout
  title="Posts & Investigações | VitaleGeo"
  description="Investigações documentais sobre enclaves soberanos, rotas navais estratégicas e disputas de fronteira."
>
  <main class="page-content">
    <header class="relative pt-36 sm:pt-44 pb-10 px-6 overflow-hidden">
      <TopoLines strokeColor="#f59e0b" />

      <div class="max-w-6xl mx-auto relative z-10">
        <div class="max-w-2xl">
          <h1 class="text-3xl sm:text-5xl font-heading font-bold text-white tracking-tight">
            Posts & Investigações
          </h1>
          <p class="text-sm sm:text-base text-slate-300 mt-3 font-normal leading-relaxed">
            Investigações documentais sobre enclaves soberanos, rotas navais estratégicas e anomalias de fronteira.
          </p>
        </div>
      </div>
    </header>

    <!-- Transição Editorial -->
    <div class="max-w-6xl mx-auto px-6 mb-8">
      <div class="h-px bg-gradient-to-r from-transparent via-white/[0.08] to-transparent"></div>
    </div>

    <section class="pb-24 px-6 max-w-6xl mx-auto min-h-[50vh]">
      <BlogArchive client:load posts={postsData} />
    </section>
  </main>
</Layout>
